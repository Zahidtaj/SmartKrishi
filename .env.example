# SmartKrishi Local Development Environment Configuration
# Copy this file to .env and replace placeholder values before running locally.

SMARTKRISHI_ENV=development
SMARTKRISHI_DATABASE_URL=sqlite:///./backend/data/smartkrishi.db
SMARTKRISHI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SMARTKRISHI_ADMIN_USERNAME=admin
# Change this password in your local .env before running in any shared environment.
SMARTKRISHI_ADMIN_PASSWORD=change-me-local-dev-admin
SMARTKRISHI_TOKEN_SECRET=replace-with-random-local-dev-secret-string
SMARTKRISHI_MODEL_DIR=./ml/artifacts
